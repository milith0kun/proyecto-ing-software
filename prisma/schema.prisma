datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modelo de prueba / entidad base inicial para CGB Academy
model User {
  id                 String                 @id @default(auto()) @map("_id") @db.ObjectId
  email              String                 @unique
  name               String?
  role               String                 @default("COLABORADOR")
  passwordHash       String?
  activo             Boolean                @default(false)
  rutaOnboardingId   String?                @db.ObjectId
  rutaOnboarding     RutaOnboarding?        @relation(fields: [rutaOnboardingId], references: [id], onDelete: SetNull)
  colaborador        Colaborador?
  sesiones           Sesion[]
  progresos          ProgresoCapacitacion[]
  intentosEvaluacion IntentoEvaluacion[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@map("users")
}

// JWT y sesión persistida: cerrar sesión revoca también el token del servidor.
model Sesion {
  id        String   @id @default(uuid()) @map("_id")
  usuarioId String   @db.ObjectId
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("sesiones")
}

// Modelo principal para la gestión de capacitaciones (HU-002 / HU-004 / HU-005)
model Capacitacion {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  titulo         String
  descripcion    String
  unidad         String    @default("CIIP") // "CIIP" | "GEOMINA" | "BIOMEDIC" | "GENERAL"
  ambito         String    @default("PUBLICO") // "PUBLICO" | "INTERNO"
  estado         String    @default("BORRADOR") // "BORRADOR" | "PUBLICADA"
  publicadaEn    DateTime?
  categoria      String?   @default("Inducción")
  duracionMin    Int?      @default(30)
  icono          String?   @default("book-open")
  creadoPor      String?
  // IDs de capacitaciones que deben estar COMPLETADAS antes de iniciar esta (HU-012)
  prerrequisitos String[]  @default([]) @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relación con Slides (para HU-003 / HU-006)
  slides                 Slide[]
  progresos              ProgresoCapacitacion[]
  progresosColaboradores ProgresoColaborador[]
  rutasOnboarding        RutaCapacitacion[]
  evaluacion             Evaluacion?
  pasosRuta              PasoRuta[]

  @@index([ambito, estado, createdAt(sort: Desc)], map: "capacitaciones_catalogo_publico")
  @@map("capacitaciones")
}

// Modelo de diapositivas interactivas por capacitación (HU-003 / HU-006)
model Slide {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  capacitacionId String       @db.ObjectId
  capacitacion   Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  orden          Int          @default(1)
  titulo         String
  contenido      String // Contenido textual principal
  tipo           String       @default("INFO") // TEXT | IMAGE | INTERACTIVE | INFO | EVALUACION
  imagenUrl      String?
  botonTexto     String?
  botonUrl       String?
  lista          String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("slides")
}

// Avance privado de un colaborador en una capacitación interna (HU-012).
// La clave única (usuario, capacitación) garantiza un solo registro por persona.
// Restrict: borrar un usuario o una capacitación no elimina en silencio el historial de avance.
model ProgresoCapacitacion {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId         String       @db.ObjectId
  usuario           User         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  capacitacionId    String       @db.ObjectId
  capacitacion      Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Restrict)
  ultimoSlide       Int          @default(1) // último slide confirmado: punto de reanudación
  slidesConfirmados Int[]        @default([]) // conjunto sin duplicados, base del porcentaje
  estado            String       @default("EN_CURSO") // "EN_CURSO" | "COMPLETADA"
  completadaEn      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([usuarioId, capacitacionId])
  @@map("progreso_capacitaciones")
}

// Pregunta de opción múltiple embebida en la evaluación. `correcta` nunca se envía al navegador antes de calificar.
type PreguntaEvaluacion {
  id                String
  enunciado         String
  opciones          String[]
  correcta          Int // índice base 0 dentro de `opciones`
  retroalimentacion String?
}

// Microtest formativo de una capacitación (HU-013 / HU-014).
// Restrict: borrar una capacitación no elimina en silencio su evaluación ni sus intentos registrados (RNF-010).
model Evaluacion {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  capacitacionId  String               @unique @db.ObjectId
  capacitacion    Capacitacion         @relation(fields: [capacitacionId], references: [id], onDelete: Restrict)
  titulo          String               @default("Microtest")
  preguntas       PreguntaEvaluacion[]
  notaMinima      Int                  @default(70) // porcentaje 0-100 para aprobar
  maxIntentos     Int                  @default(3)
  tiempoLimiteSeg Int? // temporizador opcional
  intentos        IntentoEvaluacion[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("evaluaciones")
}

// Intento calificado de un colaborador. (usuario, evaluación, número) único evita pasar el límite de intentos en solicitudes simultáneas.
// Restrict: borrar un usuario o una evaluación no elimina en silencio sus calificaciones históricas (RNF-010).
model IntentoEvaluacion {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  evaluacionId String     @db.ObjectId
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Restrict)
  usuarioId    String     @db.ObjectId
  usuario      User       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  numero       Int
  respuestas   Int[] // -1 = sin responder
  aciertos     Int
  puntaje      Int // porcentaje 0-100
  aprobado     Boolean
  enviadoEn    DateTime   @default(now())

  @@unique([usuarioId, evaluacionId, numero])
  @@map("intentos_evaluacion")
}

// Estructura organizacional (HU-007 / CGB-31)
model Area {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  nombre      String           @unique
  nombreClave String           @unique
  activa      Boolean          @default(true)
  puestos     PuestoTrabajo[]
  rutas       RutaOnboarding[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("areas")
}

model PuestoTrabajo {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  nombre      String
  nombreClave String
  areaId      String           @db.ObjectId
  area        Area             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  rutas       RutaOnboarding[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([areaId, nombre])
  @@unique([areaId, nombreClave])
  @@map("puestos_trabajo")
}

// Rutas de Onboarding y secuencia de pasos (HU-008 / CGB-36)
model RutaOnboarding {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  titulo               String?
  objetivo             String?
  nombre               String?
  descripcion          String?
  activa               Boolean?
  estado               String?            @default("BORRADOR") // "BORRADOR" | "ACTIVA"
  areaId               String?            @db.ObjectId
  area                 Area?              @relation(fields: [areaId], references: [id], onDelete: Restrict)
  puestoId             String?            @db.ObjectId
  puesto               PuestoTrabajo?     @relation(fields: [puestoId], references: [id], onDelete: SetNull)
  puestosLegacy        Puesto[]
  colaboradoresLegacy  Colaborador[]      @relation("RutaAsignadaColaborador")
  capacitacionesLegacy RutaCapacitacion[]
  activadaEn           DateTime?
  pasos                PasoRuta[]
  usuarios             User[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([areaId, puestoId, estado])
  @@map("rutas_onboarding")
}

model PasoRuta {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  rutaId         String         @db.ObjectId
  ruta           RutaOnboarding @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  capacitacionId String         @db.ObjectId
  capacitacion   Capacitacion   @relation(fields: [capacitacionId], references: [id], onDelete: Restrict)
  orden          Int
  obligatorio    Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([rutaId, orden])
  @@unique([rutaId, capacitacionId])
  @@map("pasos_ruta")
}

// Rutas y capacitaciones legacy (CGB-41 / CGB-51)
model RutaCapacitacion {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  rutaId         String         @db.ObjectId
  ruta           RutaOnboarding @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  capacitacionId String         @db.ObjectId
  capacitacion   Capacitacion   @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  orden          Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([rutaId, capacitacionId])
  @@index([rutaId, orden])
  @@map("rutas_capacitaciones")
}

model Puesto {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  nombre           String
  departamento     String?
  rutaOnboardingId String?         @db.ObjectId
  rutaOnboarding   RutaOnboarding? @relation(fields: [rutaOnboardingId], references: [id], onDelete: SetNull)
  colaboradores    Colaborador[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("puestos")
}

model Colaborador {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  nombre           String
  email            String                @unique
  dni              String?
  puestoId         String?               @db.ObjectId
  puesto           Puesto?               @relation(fields: [puestoId], references: [id], onDelete: SetNull)
  estado           String                @default("PENDIENTE_ACTIVACION")
  progreso         Int                   @default(0)
  rutaOnboardingId String?               @db.ObjectId
  rutaOnboarding   RutaOnboarding?       @relation("RutaAsignadaColaborador", fields: [rutaOnboardingId], references: [id], onDelete: SetNull)
  progresos        ProgresoColaborador[]
  userId           String?               @unique @db.ObjectId
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  tokenActivacion  String?
  enlaceActivacion String?
  tokenExpiraEn    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("colaboradores")
}

model ProgresoColaborador {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  colaboradorId    String       @db.ObjectId
  colaborador      Colaborador  @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  capacitacionId   String       @db.ObjectId
  capacitacion     Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  ultimoSlideOrden Int          @default(0)
  completada       Boolean      @default(false)
  completadaEn     DateTime?
  updatedAt        DateTime     @updatedAt

  @@unique([colaboradorId, capacitacionId])
  @@index([colaboradorId])
  @@map("progresos_capacitaciones")
}
