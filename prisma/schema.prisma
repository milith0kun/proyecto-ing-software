datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modelo de prueba / entidad base inicial para CGB Academy
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  role      String   @default("COLABORADOR")
  passwordHash String?
  activo    Boolean  @default(false)
  sesiones  Sesion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// JWT y sesión persistida: cerrar sesión revoca también el token del servidor.
model Sesion {
  id        String   @id @default(uuid()) @map("_id")
  usuarioId String   @db.ObjectId
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("sesiones")
}

// Modelo principal para la gestión de capacitaciones (HU-002 / HU-004 / HU-005)
model Capacitacion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  titulo      String
  descripcion String
  unidad      String   @default("CIIP") // "CIIP" | "GEOMINA" | "BIOMEDIC" | "GENERAL"
  ambito      String   @default("PUBLICO") // "PUBLICO" | "INTERNO"
  estado      String   @default("BORRADOR") // "BORRADOR" | "PUBLICADA"
  publicadaEn DateTime?
  categoria   String?  @default("Inducción")
  duracionMin Int?     @default(30)
  icono       String?  @default("book-open")
  creadoPor   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación con Slides (para HU-003 / HU-006)
  slides      Slide[]

  @@index([ambito, estado, createdAt(sort: Desc)], map: "capacitaciones_catalogo_publico")
  @@map("capacitaciones")
}

// Modelo de diapositivas interactivas por capacitación (HU-003 / HU-006)
model Slide {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  capacitacionId  String       @db.ObjectId
  capacitacion    Capacitacion @relation(fields: [capacitacionId], references: [id], onDelete: Cascade)
  orden           Int          @default(1)
  titulo          String
  contenido       String       // Contenido textual principal
  tipo            String       @default("INFO") // TEXT | IMAGE | INTERACTIVE | INFO | EVALUACION
  imagenUrl       String?
  botonTexto      String?
  botonUrl        String?
  lista           String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("slides")
}

// Estructura organizacional (HU-007 / CGB-31)
model Area {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String          @unique
  activa    Boolean         @default(true)
  puestos   PuestoTrabajo[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("areas")
}

model PuestoTrabajo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nombre    String
  areaId    String   @db.ObjectId
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([areaId, nombre])
  @@map("puestos_trabajo")
}
